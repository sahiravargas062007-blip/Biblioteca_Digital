<link rel="stylesheet" href="/css/components/forms.css">
<link rel="stylesheet" href="/css/components/badges.css">

<section class="panel page-header">
  <div>
    <p class="eyebrow">Registro manual</p>
    <h1>Nuevo préstamo físico</h1>
    <p class="muted">Busca al usuario y selecciona los ejemplares físicos que va a llevar en préstamo.</p>
  </div>
  <a class="secondary-link" href="/admin/prestamos">← Volver a préstamos</a>
</section>

<form method="post" action="/admin/prestamos" class="panel prestamo-steps" id="nuevo-prestamo-form">
  <div class="prestamo-step" data-combobox="usuario">
    <h3><span class="prestamo-step__num">1</span> Seleccionar usuario</h3>
    <label>Usuario activo</label>
    <div class="combobox-input-wrap">
      <input type="text" data-combobox-input autocomplete="off" placeholder="Buscar por nombre, documento o correo...">
      <div class="combobox-menu" data-combobox-menu hidden></div>
    </div>
    <input type="hidden" name="usuario_id" data-combobox-value required>
    <div class="combobox-preview" data-combobox-preview hidden></div>
    <% if (!usuarios.length) { %>
      <p class="muted prestamo-empty-msg">No hay usuarios activos registrados.</p>
    <% } %>
  </div>

  <div class="prestamo-step">
    <h3>
      <span class="prestamo-step__num">2</span> Ejemplares disponibles
      <span class="prestamo-count-badge" data-ejemplares-count hidden></span>
    </h3>
    <label for="ejemplar-filter">Buscar ejemplar</label>
    <div class="combobox-input-wrap">
      <input type="text" id="ejemplar-filter" autocomplete="off" placeholder="Buscar por título o código de inventario...">
    </div>

    <div class="prestamo-ejemplares-list" data-ejemplares-list>
      <% ejemplares.forEach((ejemplar) => { %>
        <label
          class="prestamo-ejemplar-row"
          data-ejemplar-row
          data-search="<%= (ejemplar.recurso_titulo + ' ' + ejemplar.codigo_inventario).toLowerCase() %>"
        >
          <input type="checkbox" name="ejemplar_ids" value="<%= ejemplar._id %>" data-ejemplar-checkbox>
          <span class="prestamo-ejemplar-row__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
          </span>
          <span class="prestamo-ejemplar-row__info">
            <strong><%= ejemplar.recurso_titulo %></strong>
            <small>Código: <%= ejemplar.codigo_inventario %></small>
          </span>
          <span class="badge badge-disponible"><%= ejemplar.estado %></span>
        </label>
      <% }) %>
    </div>

    <p class="muted prestamo-empty-msg" data-ejemplares-empty <%= ejemplares.length ? 'hidden' : '' %>>
      No hay ejemplares disponibles.
    </p>
    <p class="muted prestamo-empty-msg" data-ejemplares-sin-resultados hidden>
      No se encontraron ejemplares con ese criterio.
    </p>
  </div>

  <div class="prestamo-step">
    <h3><span class="prestamo-step__num">3</span> Confirmar préstamo</h3>
    <p class="muted">Se registrará un préstamo físico con fecha de hoy. El sistema valida automáticamente sanciones activas y el máximo de recursos permitidos por usuario.</p>
    <div class="form-actions">
      <a class="secondary-link" href="/admin/prestamos">Cancelar</a>
      <button type="submit">Registrar préstamo</button>
    </div>
  </div>
</form>

<script type="application/json" id="usuarios-data"><%- JSON.stringify(usuarios.map((u) => ({
  id: u._id,
  nombre: u.nombre,
  documento: u.documento,
  correo: u.correo,
  programa: u.programa_formacion || 'No registrado',
  estado: u.estado,
  prestamos_activos: u.prestamos_activos || 0
}))).replace(/</g, '\u003c') %></script>

<script src="/js/admin/prestamos-nuevo.js"></script>
