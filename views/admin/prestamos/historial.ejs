<link rel="stylesheet" href="/css/components/tables.css">
<link rel="stylesheet" href="/css/components/badges.css">

<section class="panel page-header">
      <div>
        <p class="eyebrow">Consulta histórica</p>
        <h1>Historial de préstamos</h1>
      </div>
      <a class="secondary-link" href="/admin/prestamos">← Volver a préstamos</a>
    </section>
    <section class="panel">
      <form class="toolbar" method="get" action="/admin/prestamos/historial">
        <label>
          Buscar
          <span class="input-icon-wrap">
            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input type="search" name="q" value="<%= q %>">
          </span>
        </label>
        <button type="submit" class="filter-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
          </svg>
          Filtrar
        </button>
      </form>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Usuario</th><th>Tipo</th><th>Ítems</th><th>Estado</th><th>Fecha</th></tr></thead>
          <tbody>
            <% prestamos.forEach((prestamo) => { %>
              <tr>
                <td><%= prestamo.usuario_nombre %><small><%= prestamo.usuario_documento %></small></td>
                <td><%= prestamo.tipo %></td>
                <td><%= prestamo.items.length %></td>
                <td><%= prestamo.estado %></td>
                <td><%= new Date(prestamo.creado_en).toLocaleDateString('es-CO') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
