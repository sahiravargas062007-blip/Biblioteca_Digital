<link rel="stylesheet" href="/css/components/forms.css">
<link rel="stylesheet" href="/css/components/tables.css">
<link rel="stylesheet" href="/css/pages/admin-recursos.css">
<style>
  .import-panel {
    background: #fdf8f0;
    border-radius: 14px;
    border: 1px solid rgba(201, 168, 76, 0.2);
    padding: 24px;
    box-shadow: 0 4px 15px rgba(98, 51, 7, 0.06);
    margin-bottom: 24px;
  }
  .import-panel h2 {
    color: #2c2518;
    font-family: 'Playfair Display', serif;
    margin-top: 0;
  }
</style>

<section class="panel page-header import-panel">
      <div>
        <p class="eyebrow">Registro por lotes</p>
        <h1 style="color: #2c2518; font-family: 'Playfair Display', serif;">Carga masiva ZIP</h1>
      </div>
      <a class="secondary-link" href="/admin/recursos" style="border: 1px solid rgba(201, 168, 76, 0.4); color: #2c2518;">Volver</a>
    </section>

    <% if (typeof previsualizar === 'undefined' || !previsualizar) { %>
    <%
      /*
       * ─────────────────────────────────────────────────────────────────────
       * PASO 1 — Formulario inicial: el admin selecciona el ZIP
       * ─────────────────────────────────────────────────────────────────────
       */
    %>
    <section class="panel import-panel">
      <h2>Subir archivo ZIP</h2>
      <p class="form-hint" style="margin-bottom:1rem; color: #5c5548;">
        El sistema aceptará las siguientes estructuras internas:<br>
        <strong>Estructura plana</strong> — archivos sueltos asociados por nombre (ej: <code>libro1.pdf</code> y <code>libro1.jpg</code>).<br>
        <strong>Estructura por carpetas</strong> — cada subcarpeta = 1 recurso; el nombre de la carpeta se usa como título provisional.
      </p>

      <form
        class="form-stack"
        method="post"
        action="/admin/recursos/masivo/previsualizar"
        enctype="multipart/form-data"
        onsubmit="this.classList.add('submitting')"
      >
        <label>
          Tipo de contenido del ZIP
          <select name="tipo_contenido" required>
            <option value="Lectura">Lectura — Principal: PDF / ePub, Portada: imagen, Complemento: MP3</option>
            <option value="Audio">Audio — Principal: MP3, Portada: imagen</option>
            <option value="Video">Video — Principal: MP4, Portada: imagen</option>
          </select>
        </label>

        <label>
          Archivo ZIP <small>(máx. 500 MB)</small>
          <input type="file" name="zip" accept=".zip,application/zip,application/x-zip-compressed" required>
        </label>

        <div class="panel-note">
          Los recursos se crearán con estado <strong>Pendiente de configuración</strong> y no serán visibles al público hasta que complete sus metadatos individualmente.
        </div>

                  <div class="form-actions" id="bulk-actions">
            <button type="button" id="btn-confirmar" name="accion" value="confirmar" class="af-btn-primary" <%= validos.length === 0 ? 'disabled' : '' %>>
              <span class="btn-label">Confirmar y procesar (<%= validos.length %>)</span>
            </button>
            <button
              type="button"
              id="btn-cancelar"
              name="accion"
              value="cancelar"
              class="secondary-link"
              style="background:none;border:none;cursor:pointer;padding:0"
            >Cancelar y descartar</button>
          </div>

          <!-- Progress Modal -->
          <div id="bulk-progress-container" style="display:none; margin-top:20px; padding:20px; background:#f9f9f9; border-radius:8px; border:1px solid #ddd; text-align:center;">
            <h3 style="color:#146c5f; margin-bottom:15px;">Procesando carga masiva...</h3>
            <p id="bulk-progress-text" style="color:#666; margin-bottom:10px;">Iniciando...</p>
            <div style="width:100%; height:12px; background:#e0e0e0; border-radius:6px; overflow:hidden;">
              <div id="bulk-progress-bar" style="width:0%; height:100%; background:#146c5f; transition:width 0.3s ease;"></div>
            </div>
          </div>
      </form>

      <script>
      document.addEventListener("DOMContentLoaded", function() {
        const btnConfirm = document.getElementById('btn-confirmar');
        const btnCancel = document.getElementById('btn-cancelar');
        const progressContainer = document.getElementById('bulk-progress-container');
        const progressBar = document.getElementById('bulk-progress-bar');
        const progressText = document.getElementById('bulk-progress-text');
        const actionsDiv = document.getElementById('bulk-actions');
        
        if (btnCancel) {
          btnCancel.addEventListener('click', () => {
            const form = btnCancel.closest('form');
            const input = document.createElement('input');
            input.type = 'hidden'; input.name = 'accion'; input.value = 'cancelar';
            form.appendChild(input);
            form.submit(); // cancelacin s es tradicional
          });
        }

        if (btnConfirm) {
          btnConfirm.addEventListener('click', async () => {
            actionsDiv.style.display = 'none';
            progressContainer.style.display = 'block';
            
            const form = btnConfirm.closest('form');
            const formData = new FormData(form);
            formData.append('accion', 'confirmar');
            
            try {
              const res = await fetch(form.action, { method: 'POST', body: new URLSearchParams(formData) });
              const data = await res.json();
              if (data.success && data.jobId) {
                iniciarPolling(data.jobId);
              } else {
                alert('Error al iniciar procesamiento.');
                actionsDiv.style.display = 'block';
                progressContainer.style.display = 'none';
              }
            } catch (err) {
              console.error(err);
              alert('Error de red al iniciar carga.');
            }
          });
        }
        
                function iniciarPolling(jobId) {
          const interval = setInterval(async () => {
            try {
              const res = await fetch(`/admin/recursos/masivo/progreso/${jobId}`);
              const job = await res.json();
              
              if (job.error) {
                clearInterval(interval);
                alert('Error: ' + job.error);
                return;
              }
              
              const pct = job.total > 0 ? Math.round((job.procesados / job.total) * 100) : 0;
              progressBar.style.width = pct + '%';
              progressText.innerHTML = `Procesados <strong>${job.procesados} de ${job.total}</strong> (${pct}%)<br><small>Subiendo: ${job.currentTitle || '...'}</small>`;
              
              if (job.status === 'completado') {
                clearInterval(interval);
                progressText.innerHTML = `<strong style="color:green;">�Carga completada!</strong><br>Creados: ${job.creados} | Actualizados: ${job.actualizados}`;
                setTimeout(() => {
                  window.location.href = '/admin/recursos';
                }, 2000);
              }
            } catch (e) {
              console.error(e);
            }
          }, 1500);
        }
      });
      </script>
    </section>

    <% } else { %>
    <%
      /*
       * ─────────────────────────────────────────────────────────────────────
       * PASO 2 — Vista previa: el admin revisa y confirma o cancela (CA4)
       * ─────────────────────────────────────────────────────────────────────
       */
        const nuevos = recursos.filter(r => r.estadoDeteccion === 'Nuevo');
        const pendientes = recursos.filter(r => r.estadoDeteccion === 'Archivo pendiente encontrado');
        const ignorados = recursos.filter(r => r.estadoDeteccion === 'Ya existente con archivo');
        const erroresDet = recursos.filter(r => r.estadoDeteccion === 'Error');
        const validos = [...nuevos, ...pendientes];
      %>
      <section class="panel import-panel">
        <h2>Vista previa de la carga</h2>
        <p class="form-hint" style="color: #5c5548;">
          Revise los recursos detectados antes de confirmar. <strong>Nuevos</strong> se crearán. <strong>Pendientes</strong> recibirán el archivo. <strong>Ya existentes</strong> se ignorarán.
        </p>

        <!-- Resumen estadístico -->
        <div class="summary-bar">
          <div class="summary-stat">
            <strong><%= recursos.length %></strong>
            Total detectados
          </div>
          <div class="summary-stat">
            <strong style="color:#065f46"><%= nuevos.length %></strong>
            Nuevos a crear
          </div>
          <div class="summary-stat">
            <strong style="color:#0369a1"><%= pendientes.length %></strong>
            Archivos a adjuntar
          </div>
          <div class="summary-stat">
            <strong style="color:#9ca3af"><%= ignorados.length %></strong>
            Ya existentes (ignorados)
          </div>
          <div class="summary-stat">
            <strong style="color:#991b1b"><%= erroresDet.length %></strong>
            Con errores
          </div>
        </div>

        <!-- Tabla de recursos detectados -->
        <% if (recursos.length > 0) { %>
        <div style="overflow-x:auto">
          <table class="preview-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Título provisional</th>
                <th>Estado</th>
                <th>Clasificación</th>
                <th>Portada</th>
              </tr>
            </thead>
            <tbody>
              <% recursos.forEach((r, i) => { %>
              <tr>
                <td style="color:var(--text-muted,#6b7280);font-size:.8rem"><%= i + 1 %></td>
                <td><strong><%= r.titulo %></strong></td>
                <td>
                  <% if (r.tieneMain) { %>
                    <span class="badge-ok">Listo</span>
                  <% } else { %>
                    <span class="badge-error">Sin archivo principal</span>
                  <% } %>
                </td>
                <td>
                  <% if (r.estadoDeteccion === 'Nuevo') { %>
                    <span class="badge-ok" style="background:#dcfce7;color:#166534">Nuevo</span>
                  <% } else if (r.estadoDeteccion === 'Archivo pendiente encontrado') { %>
                    <span class="badge-warn" style="background:#dbeafe;color:#1e40af">Pendiente encontrado</span>
                  <% } else if (r.estadoDeteccion === 'Ya existente con archivo') { %>
                    <span style="background:#f3f4f6;color:#374151;padding:2px 6px;border-radius:4px;font-size:0.75rem">Ya existente</span>
                  <% } else { %>
                    <span class="badge-error">Error</span>
                  <% } %>
                </td>
                <td>
                  <% if (r.tienePortada) { %>
                    <span class="badge-ok">Incluida</span>
                  <% } else { %>
                    <span class="badge-warn">Placeholder</span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>

      <!-- Errores de detección (CA4) -->
      <% if (errores && errores.length > 0) { %>
      <div class="errores-lista">
        <strong style="font-size:.9rem">Problemas detectados:</strong>
        <ul style="margin:.5rem 0 0; padding-left:1.2rem">
          <% errores.forEach(e => { %>
          <li><%= e %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <!-- Formulario de confirmación / cancelación (CA5 y CA6) -->
      <form
        class="form-stack"
        method="post"
        action="/admin/recursos/masivo/confirmar"
        style="margin-top:1.5rem"
        onsubmit="if(this.accion && this.accion.value!=='cancelar') this.classList.add('submitting')"
      >
        <!-- El ZIP temporal se identifica por nombre de archivo para no reenviar el contenido completo -->
        <input type="hidden" name="tipo_contenido" value="<%= tipoContenido %>">
        <input type="hidden" name="zip_temp_name" value="<%= zipTempName %>">

        <% if (validos.length > 0) { %>
        <div class="panel-note">
          Se procesarán <strong><%= validos.length %> recurso(s)</strong> (Nuevos + Pendientes).
          Este proceso puede tardar varios minutos dependiendo del tamaño de los archivos.
        </div>
        <% } else { %>
        <div class="panel-note">
          No hay recursos válidos para procesar (todos son errores o ya existen).
        </div>
        <% } %>

                  <div class="form-actions" id="bulk-actions">
            <button type="button" id="btn-confirmar" name="accion" value="confirmar" class="af-btn-primary" <%= validos.length === 0 ? 'disabled' : '' %>>
              <span class="btn-label">Confirmar y procesar (<%= validos.length %>)</span>
            </button>
            <button
              type="button"
              id="btn-cancelar"
              name="accion"
              value="cancelar"
              class="secondary-link"
              style="background:none;border:none;cursor:pointer;padding:0"
            >Cancelar y descartar</button>
          </div>

          <!-- Progress Modal -->
          <div id="bulk-progress-container" style="display:none; margin-top:20px; padding:20px; background:#f9f9f9; border-radius:8px; border:1px solid #ddd; text-align:center;">
            <h3 style="color:#146c5f; margin-bottom:15px;">Procesando carga masiva...</h3>
            <p id="bulk-progress-text" style="color:#666; margin-bottom:10px;">Iniciando...</p>
            <div style="width:100%; height:12px; background:#e0e0e0; border-radius:6px; overflow:hidden;">
              <div id="bulk-progress-bar" style="width:0%; height:100%; background:#146c5f; transition:width 0.3s ease;"></div>
            </div>
          </div>
      </form>

      <script>
      document.addEventListener("DOMContentLoaded", function() {
        const btnConfirm = document.getElementById('btn-confirmar');
        const btnCancel = document.getElementById('btn-cancelar');
        const progressContainer = document.getElementById('bulk-progress-container');
        const progressBar = document.getElementById('bulk-progress-bar');
        const progressText = document.getElementById('bulk-progress-text');
        const actionsDiv = document.getElementById('bulk-actions');
        
        if (btnCancel) {
          btnCancel.addEventListener('click', () => {
            const form = btnCancel.closest('form');
            const input = document.createElement('input');
            input.type = 'hidden'; input.name = 'accion'; input.value = 'cancelar';
            form.appendChild(input);
            form.submit(); // cancelacin s es tradicional
          });
        }

        if (btnConfirm) {
          btnConfirm.addEventListener('click', async () => {
            actionsDiv.style.display = 'none';
            progressContainer.style.display = 'block';
            
            const form = btnConfirm.closest('form');
            const formData = new FormData(form);
            formData.append('accion', 'confirmar');
            
            try {
              const res = await fetch(form.action, { method: 'POST', body: new URLSearchParams(formData) });
              const data = await res.json();
              if (data.success && data.jobId) {
                iniciarPolling(data.jobId);
              } else {
                alert('Error al iniciar procesamiento.');
                actionsDiv.style.display = 'block';
                progressContainer.style.display = 'none';
              }
            } catch (err) {
              console.error(err);
              alert('Error de red al iniciar carga.');
            }
          });
        }
        
                function iniciarPolling(jobId) {
          const interval = setInterval(async () => {
            try {
              const res = await fetch(`/admin/recursos/masivo/progreso/${jobId}`);
              const job = await res.json();
              
              if (job.error) {
                clearInterval(interval);
                alert('Error: ' + job.error);
                return;
              }
              
              const pct = job.total > 0 ? Math.round((job.procesados / job.total) * 100) : 0;
              progressBar.style.width = pct + '%';
              progressText.innerHTML = `Procesados <strong>${job.procesados} de ${job.total}</strong> (${pct}%)<br><small>Subiendo: ${job.currentTitle || '...'}</small>`;
              
              if (job.status === 'completado') {
                clearInterval(interval);
                progressText.innerHTML = `<strong style="color:green;">�Carga completada!</strong><br>Creados: ${job.creados} | Actualizados: ${job.actualizados}`;
                setTimeout(() => {
                  window.location.href = '/admin/recursos';
                }, 2000);
              }
            } catch (e) {
              console.error(e);
            }
          }, 1500);
        }
      });
      </script>
    </section>
    <% } %>


