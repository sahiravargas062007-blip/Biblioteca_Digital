
  <% if (sanciones.length > 0) { %>
  <section class="panel page-title-panel">
    <p class="eyebrow">Estado del usuario</p>
    <h1>Mis sanciones</h1>
    <p class="muted">Consulta tus sanciones activas e historial de sanciones levantadas.</p>
  </section>
<% } %>

  <% if (!sanciones.length) { %>
    <section class="empty-state" style="position:relative; padding-top: 8rem;">
      <div style="position: absolute; top: 30px; left: 30px; text-align: left;">
        <p class="eyebrow" style="color:#146c5f; margin:0;">Estado del usuario</p>
        <h1 style="color:#2c2518; margin: 4px 0; font-size:1.8rem; font-family:'Playfair Display',serif;">Mis sanciones</h1>
        <p class="muted" style="color:#5c5548; margin:0; font-size:0.9rem;">Consulta tus sanciones activas e historial de sanciones levantadas.</p>
      </div>
      <div class="empty-state-icon-wrapper">
        <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path d="M9 12l2 2 4-4"></path>
        </svg>
      </div>
      <h2 class="empty-state-title">¡Excelente! No tienes sanciones</h2>
      <p class="empty-state-text">No tienes multas activas, bloqueos ni sanciones registradas en tu cuenta. Sigue cumpliendo con las normas y disfrutando de nuestros recursos.</p>
      <div class="empty-state-divider">
        <span></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 12l10 10 10-10L12 2z"/></svg>
        <span></span>
      </div>
      <a href="/catalogo" class="empty-state-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        Explorar materiales
      </a>
    </section>
  <% } else { %>
    <% if (sancionsActivas > 0) { %>
      <section class="panel alert-panel">
        <h2>Sanciones activas</h2>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Tipo</th>
                <th>Incidencia</th>
                <th>Gravedad</th>
                <th>Observaciones</th>
                <th>Registrada</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              <% sanciones.forEach((sancion) => {
                if (sancion.estaVigente) { %>
                <tr>
                  <td><strong><%= sancion.tipo_sancion %></strong></td>
                  <td><%= sancion.tipo_incidencia %></td>
                  <td>
                    <span class="badge <%= sancion.gravedad === 'Grave' ? 'badge-no-disponible' : sancion.gravedad === 'Moderada' ? 'badge-warning' : 'badge-disponible' %>">
                      <%= sancion.gravedad %>
                    </span>
                  </td>
                  <td><small><%= sancion.observaciones || '-' %></small></td>
                  <td><%= new Date(sancion.creado_en).toLocaleString('es-CO') %></td>
                  <td>
                    <% if (sancion.tipo_sancion === 'Suspensión' && sancion.diasFaltantes) { %>
                      <span class="badge badge-warning"><%= sancion.diasFaltantes %> días</span>
                    <% } else { %>
                      <span class="badge badge-no-disponible">Activa</span>
                    <% } %>
                  </td>
                </tr>
              <% }
              }); %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>

    <% if (sancionsHistorico > 0) { %>
      <section class="panel">
        <h2>Historial de sanciones</h2>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Tipo</th>
                <th>Incidencia</th>
                <th>Registrada</th>
                <th>Levantada</th>
              </tr>
            </thead>
            <tbody>
              <% sanciones.forEach((sancion) => {
                if (sancion.estado === 'Levantada') { %>
                <tr>
                  <td><strong><%= sancion.tipo_sancion %></strong></td>
                  <td><%= sancion.tipo_incidencia %></td>
                  <td><%= new Date(sancion.creado_en).toLocaleString('es-CO') %></td>
                  <td><%= sancion.fecha_levantamiento ? new Date(sancion.fecha_levantamiento).toLocaleString('es-CO') : '-' %></td>
                </tr>
              <% }
              }); %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>
  <% } %>

