
  <section class="panel page-title-panel">
    <p class="eyebrow">Actividad</p>
    <h1>Mis reservas</h1>
    <p class="muted">Aqui se mostraran tus reservas activas y el estado de cada solicitud.</p>
  </section>

  <% if (!reservas.length) { %>
    <section class="empty-state">
      <div class="empty-state-icon-wrapper">
        <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
      </div>
      <h2 class="empty-state-title">Aún no tienes reservas</h2>
      <p class="empty-state-text">Tus solicitudes para apartar libros o materiales físicos se mostrarán aquí.</p>
      <div class="empty-state-divider">
        <span></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 12l10 10 10-10L12 2z"/></svg>
        <span></span>
      </div>
      <a href="/catalogo" class="empty-state-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        Explorar materiales
      </a>
    </section>
  <% } else { %>
    <section class="panel">
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Recurso</th>
              <th>Tipo</th>
              <th>Estado</th>
              <th>Posición</th>
              <th>Reserva</th>
              <th>Reclamo hasta</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% reservas.forEach((reserva) => { %>
              <tr>
                <td><strong><%= reserva.recurso_titulo %></strong></td>
                <td><%= reserva.tipo %></td>
                <td>
                  <span class="badge <%= reserva.estado === 'Disponible para reclamar' ? 'badge-disponible' : reserva.estado === 'Pendiente' ? 'badge-warning' : 'badge-no-disponible' %>"><%= reserva.estado %></span>
                </td>
                <td><%= reserva.posicion %></td>
                <td><%= new Date(reserva.fecha_reserva).toLocaleString('es-CO') %></td>
                <td><%= reserva.fecha_limite_reclamo ? new Date(reserva.fecha_limite_reclamo).toLocaleString('es-CO') : 'No asignado' %></td>
                <td>
                  <% if (['Pendiente', 'Disponible para reclamar'].includes(reserva.estado)) { %>
                    <form method="post" action="/reservas/<%= reserva._id %>/cancelar">
                      <button type="submit" class="secondary-link">Cancelar</button>
                    </form>
                  <% } else { %>
                    <span class="muted">No disponible</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

