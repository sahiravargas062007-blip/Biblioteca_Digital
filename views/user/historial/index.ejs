
  <section class="panel page-title-panel">
    <p class="eyebrow">Actividad</p>
    <h1>Historial</h1>
    <p class="muted">Aquí se lista el historial de préstamos, devoluciones y consultas realizadas.</p>
  </section>

  <% if (!prestamos.length) { %>
    <section class="empty-state">
      <div class="empty-state-icon-wrapper">
        <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <h2 class="empty-state-title">Aún no hay actividad</h2>
      <p class="empty-state-text">Tu historial de préstamos, devoluciones y consultas aparecerá aquí.</p>
      <div class="empty-state-divider">
        <span></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 12l10 10 10-10L12 2z"/></svg>
        <span></span>
      </div>
      <a href="/catalogo" class="empty-state-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        Explorar materiales
      </a>
    </section>
  <% } else { %>
    <% prestamos.forEach((prestamo) => { %>
      <section class="panel historial-panel">
        <div class="historial-header">
          <h2><%= prestamo.tipo %> · <%= prestamo.items.length %> recurso(s)</h2>
          <span class="badge <%= prestamo.estado === 'Devuelto' ? 'badge-disponible' : 'badge-no-disponible' %>">
            <%= prestamo.estado %>
          </span>
        </div>

        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Recurso</th>
                <th>Inicio</th>
                <th>Vencimiento</th>
                <th>Devolución</th>
                <th>Días usados</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              <% prestamo.items.forEach((item) => { %>
                <tr>
                  <td><strong><%= item.recurso_titulo %></strong></td>
                  <td><%= new Date(item.fecha_inicio).toLocaleString('es-CO') %></td>
                  <td><%= new Date(item.fecha_limite).toLocaleString('es-CO') %></td>
                  <td><%= item.fecha_devolucion_real ? new Date(item.fecha_devolucion_real).toLocaleString('es-CO') : 'Pendiente' %></td>
                  <td><%= item.diasUsados || '-' %></td>
                  <td>
                    <span class="badge badge-<%= item.estado === 'Devuelto' ? 'disponible' : 'no-disponible' %>">
                      <%= item.estado %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    <% }) %>
  <% } %>

