<section class="page-title-panel">
  <h1>
    Mi perfil
    <svg width="40" height="20" viewBox="0 0 100 20" fill="none"><path d="M10 10 Q 25 20, 40 10 T 70 10 T 90 10" stroke-width="2" fill="none"/></svg>
  </h1>
  <p>Gestiona tu información personal y las preferencias de tu cuenta.</p>
</section>

<%- include('../../partials/alertas') %>

<div class="perfil-grid">

  <!-- Columna Izquierda: Información y Contacto -->
  <div class="perfil-grid__col">

    <section class="panel">
      <div class="perfil-card__head">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <h2>Información personal</h2>
      </div>

      <form method="post" action="/perfil?_method=PUT" class="form-stack">
        <label class="field-label">
          Nombre completo
          <div class="field-input-wrap">
            <input type="text" name="nombre" value="<%= usuario.nombre %>" required>
          </div>
        </label>

        <div class="perfil-doc-grid">
          <label class="field-label">
            Tipo de Documento
            <div class="field-input-wrap">
              <select name="tipo_documento" class="<%= !perfilIncompleto ? 'is-locked' : '' %>" <%= !perfilIncompleto ? 'disabled' : 'required' %>>
                <option value="CC" <%= usuario.tipo_documento === 'CC' ? 'selected' : '' %>>Cédula (CC)</option>
                <option value="TI" <%= usuario.tipo_documento === 'TI' ? 'selected' : '' %>>Tarjeta (TI)</option>
                <option value="CE" <%= usuario.tipo_documento === 'CE' ? 'selected' : '' %>>C. Extranjería (CE)</option>
                <option value="PAS" <%= usuario.tipo_documento === 'PAS' ? 'selected' : '' %>>Pasaporte (PAS)</option>
              </select>
            </div>
          </label>
          <label class="field-label">
            Número de Documento
            <div class="field-input-wrap">
              <input type="text" name="documento" value="<%= usuario.documento || '' %>" class="<%= !perfilIncompleto ? 'is-locked' : '' %>" <%= !perfilIncompleto ? 'readonly' : 'required' %> placeholder="Ingresa tu documento">
            </div>
            <% if (!perfilIncompleto) { %><small class="field-hint">Este dato está protegido y no se puede editar.</small><% } %>
          </label>
        </div>

        <div class="field-section">
          <div class="perfil-card__head">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <h2>Información de contacto</h2>
          </div>

          <div class="field-block">
            <label class="field-label">
              Correo electrónico
              <div class="field-input-wrap">
                <input type="email" name="correo" value="<%= usuario.correo %>" required>
              </div>
              <small class="field-hint">Se usará para enviar notificaciones e iniciar sesión.</small>
            </label>
          </div>

          <div class="field-block">
            <label class="field-label">
              Teléfono
              <div class="field-input-wrap">
                <input type="tel" name="telefono" value="<%= usuario.telefono || '' %>" placeholder="Ingresa tu teléfono">
              </div>
            </label>
          </div>
        </div>

        <button type="submit" class="btn-submit">
          Guardar cambios
        </button>
      </form>
    </section>
  </div>

  <!-- Columna Derecha: Seguridad y Estadísticas -->
  <div class="perfil-grid__col">

    <section class="panel">
      <div class="perfil-card__head">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <h2>Seguridad</h2>
      </div>
      <p class="perfil-card__desc">Cambia tu contraseña periódicamente para mantener tu cuenta segura.</p>

      <form method="post" action="/perfil/password" class="form-stack">
        <div class="field-block">
          <label class="field-label">
            Contraseña actual
            <div class="field-input-wrap field-input-wrap--icon">
              <span class="field-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
              <input type="password" name="passwordActual" required placeholder="Ingresa tu contraseña actual">
            </div>
          </label>
        </div>
        <div class="field-block">
          <label class="field-label">
            Nueva contraseña
            <div class="field-input-wrap field-input-wrap--icon">
              <span class="field-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
              <input type="password" name="nuevaPassword" required minlength="8" placeholder="De 8 a 20 caracteres">
            </div>
          </label>
        </div>
        <div class="field-block">
          <label class="field-label">
            Confirmar nueva contraseña
            <div class="field-input-wrap field-input-wrap--icon">
              <span class="field-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
              <input type="password" name="confirmarPassword" required minlength="8" placeholder="Repite la nueva contraseña">
            </div>
          </label>
        </div>
        <button type="submit" class="btn-submit">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Actualizar contraseña
        </button>
      </form>
    </section>

    <section class="panel">
      <div class="perfil-card__head perfil-card__head--tight">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        <h2>Estadísticas</h2>
      </div>
      <p class="perfil-card__desc">Resumen de tu actividad en BiblioNet</p>

      <div class="perfil-stats">
        <div class="perfil-stat">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <strong><%= usuario.prestamos_activos || 0 %></strong>
          <span>Préstamos activos</span>
        </div>
        <div class="perfil-stat">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <strong><%= usuario.reservas_activas || 0 %></strong>
          <span>Reservas activas</span>
        </div>
        <div class="perfil-stat">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <strong>
            <%
              const createdAt = new Date(usuario.creado_en);
              const now = new Date();
              const diffTime = Math.abs(now - createdAt);
              const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            %>
            <%= diffDays %>
          </strong>
          <span>Días como usuario</span>
        </div>
      </div>

    </section>

  </div>
</div>
